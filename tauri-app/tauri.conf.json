{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AE数据分析",
  "version": "1.0.1",
  "identifier": "com.ae.data-analysis",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AE数据分析",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icon.ico"]
  }
}
